{
  "typescript": {
    "lineWidth": 500,
  },
  "json": {
    "jsonTrailingCommaFiles": [
      ".vscode/settings.json",
      "src/dot_config/zed/settings.json",
    ],
  },
  "markdown": {
    "emphasisKind": "asterisks",
  },
  "toml": {
  },
  "yaml": {
  },
  "markup": {
    "associations": [
      "**/*.html",
      "**/*.xml",
      "**/fontconfig/**/*.conf",
    ],
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/.chezmoitemplates",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.2",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:@dprint/ruff@0.8.5",
  ],
}
